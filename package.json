{
    "name": "@bunkerch/modernssh",
    "version": "1.0.0",
    "description": "A modern, typed SSH client and server library for Node.js",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "test": "pnpm run build && pnpm run docs:api:check && bun --smol test --max-concurrency=1 --dots ./__tests__/*/*",
        "build": "pnpm run clean && tsc",
        "dev": "tsc --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "docs:api": "pnpm run build && node scripts/generate-api-reference.mjs",
        "docs:api:check": "node scripts/generate-api-reference.mjs --check",
        "prepare": "husky",
        "prepack": "pnpm run build"
    },
    "lint-staged": {
        "*.{js,ts,json,md,yaml,yml}": "prettier --write"
    },
    "author": "Manaf",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bunkerch/node-ssh.git"
    },
    "keywords": [
        "ssh",
        "typescript",
        "client",
        "server"
    ],
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@stylistic/eslint-plugin": "^5.5.0",
        "@types/node": "^20.0.0",
        "bun": "^1.3.14",
        "eslint": "^9.38.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.6.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2"
    },
    "dependencies": {
        "@noble/curves": "^2.2.0",
        "@noble/hashes": "^2.2.0",
        "@noble/post-quantum": "^0.6.1",
        "asn1js": "^3.0.10",
        "bcrypt-pbkdf": "^1.0.2",
        "koffi": "3.1.1",
        "pako": "^3.0.1",
        "tweetnacl": "^1.0.3"
    },
    "packageManager": "pnpm@10.19.0"
}
